	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"New Stage": {
		"scope": "haxe",
		"prefix": "stage.new",
		"body": [
			"package koya.frontend.scenes.play.stages.basegame;\n",

			"import koya.backend.songs.Song.SwagSong;\n",

			"class $1 extends StageBackground",
			"{",
			"\toverride public function new(song:SwagSong, ?performInit:Bool = true)",
			"\t{",
			"\t\tsuper(song, '$1', performInit);",
			"\t}",
			"}",
		],
		"description": "New Stage Script",
	},

	"New Scene": {
		"scope": "haxe",
		"prefix": "scene.new",
		"body": [
			"package koya.frontend.scenes;\n",

			"class $1 extends MusicBeatState",
			"{",
			"}",
		],
		"description": "New Scene",
	},
}
